<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Core">
            <directory>app-modules/core/tests</directory>
            <exclude>app-modules/core/tests/Browser</exclude>
        </testsuite>
        <testsuite name="User">
            <directory>app-modules/user/tests</directory>
            <exclude>app-modules/user/tests/Browser</exclude>
        </testsuite>
        <testsuite name="Auth">
            <directory>app-modules/auth/tests</directory>
            <exclude>app-modules/auth/tests/Browser</exclude>
        </testsuite>
        <testsuite name="Workspace">
            <directory>app-modules/workspace/tests</directory>
            <exclude>app-modules/workspace/tests/Browser</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>app-modules/core/src</directory>
            <directory>app-modules/user/src</directory>
            <directory>app-modules/auth/src</directory>
            <directory>app-modules/workspace/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
